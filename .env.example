# Salin menjadi .env lalu isi. JANGAN commit .env.
# Panduan lengkap: docs/SETUP.md

# --- Basis data (Neon) ---
# Pooled — dipakai runtime aplikasi
DATABASE_URL=""
# Direct (tanpa -pooler) — dipakai migrasi Prisma
DIRECT_URL=""

# --- Autentikasi (Auth.js v5) ---
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# github.com/settings/developers → OAuth Apps
# Callback: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Daftar email pemilik, dipisah koma.
# HANYA email di sini yang memperoleh peran OWNER (BRULE-01).
OWNER_EMAILS=""

# --- Situs ---
# URL kanonik: dipakai sitemap, RSS, OG image, dan metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Opsional ---
# Vercel Blob. Kosong = unggah gambar dinonaktifkan.
BLOB_READ_WRITE_TOKEN=""
# Melindungi /api/cron/publish (penjadwalan terbit)
CRON_SECRET=""
